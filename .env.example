# Application Environment (development | production | testing)
ENVIRONMENT=development

# Database Configuration
DB_ROOT_PASS=rootpassword
DB_USER=shopsphere_user
DB_PASS=shopsphere_password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=shopsphere

# Security & JWT Configuration
# In production, SECRET_KEY is mandatory and cannot use default fallback
SECRET_KEY=generate_a_secure_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Payments (Razorpay)
# Set RAZORPAY_IS_DEMO=false when using live credentials
RAZORPAY_IS_DEMO=true
RAZORPAY_KEY_ID=rzp_test_shopsphere_key
RAZORPAY_KEY_SECRET=rzp_test_shopsphere_secret

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ShopSphere <no-reply@shopsphere.com>

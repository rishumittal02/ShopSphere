# Database Configuration
# Option 1: Standard connection string
DATABASE_URL=mysql+pymysql://root:your_db_password@localhost:3306/shopsphere

# Option 2: Individual parameters (used if DATABASE_URL is not set)
DB_USER=root
DB_PASS=your_db_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopsphere

# Security & JWT Configuration
SECRET_KEY=your_super_secret_jwt_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
